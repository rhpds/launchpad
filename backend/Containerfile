FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS oc-builder

ARG OPENSHIFT_CLIENT_COMMIT=d0f23b14fbf35493e5b713e25ecf662ec239e76c
ARG GO_X_TEXT_VERSION=v0.41.0
ARG GO_X_NET_VERSION=v0.60.0
ARG GO_JOSE_VERSION=v4.1.4
ARG SPDYSTREAM_VERSION=v0.5.1
ARG GO_GIT_VERSION=v5.19.2
ARG GO_BILLY_VERSION=v5.9.0
ARG OTEL_VERSION=v1.41.0
ARG FULCIO_VERSION=v1.8.6
ARG GO_COMPRESS_VERSION=v1.18.7
ENV GOTOOLCHAIN=go1.26.9
ARG HELM_VERSION=4.3.0
ARG HELM_SOURCE_COMMIT=bec5b06ed841fe5269972d864d5177944fd5970f

WORKDIR /tmp/oc
RUN git clone https://github.com/openshift/oc.git . \
    && git checkout --detach "${OPENSHIFT_CLIENT_COMMIT}" \
    && go mod edit \
      -replace=golang.org/x/text=golang.org/x/text@${GO_X_TEXT_VERSION} \
      -replace=golang.org/x/net=golang.org/x/net@${GO_X_NET_VERSION} \
      -replace=github.com/go-jose/go-jose/v4=github.com/go-jose/go-jose/v4@${GO_JOSE_VERSION} \
      -replace=github.com/moby/spdystream=github.com/moby/spdystream@${SPDYSTREAM_VERSION} \
      -replace=github.com/go-git/go-git/v5=github.com/go-git/go-git/v5@${GO_GIT_VERSION} \
      -replace=github.com/go-git/go-billy/v5=github.com/go-git/go-billy/v5@${GO_BILLY_VERSION} \
      -replace=go.opentelemetry.io/otel=go.opentelemetry.io/otel@${OTEL_VERSION} \
      -replace=go.opentelemetry.io/otel/trace=go.opentelemetry.io/otel/trace@${OTEL_VERSION} \
      -replace=github.com/sigstore/fulcio=github.com/sigstore/fulcio@${FULCIO_VERSION} \
      -replace=github.com/klauspost/compress=github.com/klauspost/compress@${GO_COMPRESS_VERSION} \
    && CGO_ENABLED=0 go build -mod=mod \
      -tags "include_gcs include_oss containers_image_openpgp" \
      -trimpath -o /tmp/oc-bin ./cmd/oc \
    && go version -m /tmp/oc-bin \
    | grep -F "golang.org/x/text" \
    | grep -F "v0.41.0" \
    && go version -m /tmp/oc-bin \
    | grep -F "github.com/go-jose/go-jose/v4" \
    | grep -F "${GO_JOSE_VERSION}" \
    && go version -m /tmp/oc-bin \
    | grep -F "github.com/moby/spdystream" \
    | grep -F "${SPDYSTREAM_VERSION}" \
    && go version -m /tmp/oc-bin \
    | grep -F "github.com/go-git/go-git/v5" \
    | grep -F "${GO_GIT_VERSION}" \
    && go version -m /tmp/oc-bin \
    | grep -F "github.com/go-git/go-billy/v5" \
    | grep -F "${GO_BILLY_VERSION}" \
    && go version -m /tmp/oc-bin \
    | grep -F "go.opentelemetry.io/otel" \
    | grep -F "${OTEL_VERSION}" \
    && go version -m /tmp/oc-bin \
    | grep -F "github.com/sigstore/fulcio" \
    | grep -F "${FULCIO_VERSION}" \
    && go version -m /tmp/oc-bin \
    | grep -F "github.com/klauspost/compress" \
    | grep -F "${GO_COMPRESS_VERSION}"

WORKDIR /tmp/helm
RUN git clone https://github.com/helm/helm.git . \
    && git checkout --detach "${HELM_SOURCE_COMMIT}" \
    && go mod edit \
      -replace=golang.org/x/net=golang.org/x/net@${GO_X_NET_VERSION} \
      -replace=github.com/klauspost/compress=github.com/klauspost/compress@${GO_COMPRESS_VERSION} \
    && CGO_ENABLED=0 go build -mod=mod -trimpath \
      -ldflags="-s -w -X helm.sh/helm/v4/internal/version.version=v${HELM_VERSION} -X helm.sh/helm/v4/internal/version.gitCommit=${HELM_SOURCE_COMMIT}" \
      -o /tmp/helm-bin ./cmd/helm \
    && /tmp/helm-bin version --short | grep -F "v${HELM_VERSION}" \
    && go version -m /tmp/helm-bin > /tmp/helm-build-info.txt \
    && cat /tmp/helm-build-info.txt \
    && if grep -F "github.com/klauspost/compress" /tmp/helm-build-info.txt; then \
      grep -F "github.com/klauspost/compress" /tmp/helm-build-info.txt \
      | grep -F "${GO_COMPRESS_VERSION}"; \
    fi

FROM registry.access.redhat.com/ubi9/python-312:latest

LABEL name="partner-ai-launchpad-backend" \
      version="0.1.0" \
      description="Partner AI Launchpad — Backend API"

WORKDIR /opt/app-root/src

# The UBI S2I base includes Apache and graphics build packages that our uvicorn
# runtime does not use. Disable dependency autoremove for this bounded removal.
USER 0
RUN dnf -y upgrade \
    && (dnf -y remove npm 'nodejs*' || true) \
    && dnf -y remove --setopt=clean_requirements_on_remove=False \
      httpd httpd-core httpd-devel httpd-filesystem httpd-tools \
      mod_ldap mod_lua mod_session mod_ssl gd gd-devel \
      kernel-headers python3.11-devel python3.12-devel expat-devel libblkid-devel libmount-devel \
      go-srpm-macros qt5-srpm-macros emacs-filesystem vim-filesystem vim-minimal \
      libX11-devel \
    && dnf clean all

COPY --from=oc-builder /tmp/oc-bin /usr/local/bin/oc
COPY --from=oc-builder /tmp/helm-bin /usr/local/bin/helm

RUN pip install --no-cache-dir --upgrade setuptools \
    && pip install --no-cache-dir pydantic pyyaml fastapi uvicorn httpx websockets python-multipart sqlalchemy psycopg2-binary kubernetes requests "celery[redis]" kafka-python-ng argon2-cffi cryptography

COPY backend/app/ ./app/
COPY frontend/public/logos/ ./public/logos/
COPY backend/migrations/ ./migrations/
COPY backend/celery_app.py ./celery_app.py
COPY backend/tasks/ ./tasks/
COPY backend/scripts/ ./scripts/
COPY deploy/ /opt/deploy/
COPY demos/deploy/ /opt/demos-deploy/
COPY config/ /opt/config/

# Catalog items (YAML-driven demo definitions)
COPY catalog/ /opt/catalog/

# Quickstarts are optional — cloned upstream repos, not always in git.
RUN mkdir -p /opt/quickstarts
RUN if [ -d /opt/quickstarts/rag ]; then \
      helm repo add ai-quickstart https://rh-ai-quickstart.github.io/ai-architecture-charts 2>/dev/null || true \
      && helm repo update 2>/dev/null || true \
      && cd /opt/quickstarts/rag/deploy/helm/rag && helm dependency build . 2>&1 || true \
      && cd /opt/quickstarts/llm-cpu-serving/helm && helm dependency build . 2>&1 || true; \
    else echo "Quickstarts not present — skipping Helm dependency build"; fi

USER 1001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
