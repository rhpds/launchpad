FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS oc-builder

ARG OPENSHIFT_CLIENT_COMMIT=d0f23b14fbf35493e5b713e25ecf662ec239e76c
ARG GO_X_TEXT_VERSION=v0.41.0

WORKDIR /tmp/oc
RUN git clone https://github.com/openshift/oc.git . \
    && git checkout --detach "${OPENSHIFT_CLIENT_COMMIT}" \
    && go mod edit \
      -replace=golang.org/x/text=golang.org/x/text@${GO_X_TEXT_VERSION} \
    && CGO_ENABLED=0 go build -mod=mod \
      -tags "include_gcs include_oss containers_image_openpgp" \
      -trimpath -o /tmp/oc-bin ./cmd/oc \
    && go version -m /tmp/oc-bin \
    | grep -F "golang.org/x/text" \
    | grep -F "v0.41.0"

FROM registry.access.redhat.com/ubi9/python-311:latest

LABEL name="partner-ai-launchpad-backend" \
      version="0.1.0" \
      description="Partner AI Launchpad — Backend API"

WORKDIR /opt/app-root/src

USER 0
ARG HELM_VERSION=4.3.0
RUN dnf -y upgrade \
    && (dnf -y remove npm 'nodejs*' || true) \
    && dnf clean all \
    && curl --fail --silent --show-error --location \
      "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
    | tar xz -C /usr/local/bin --strip-components=1 linux-amd64/helm \
    && chmod +x /usr/local/bin/helm

COPY --from=oc-builder /tmp/oc-bin /usr/local/bin/oc

RUN pip install --no-cache-dir --upgrade setuptools \
    && pip install --no-cache-dir pydantic pyyaml fastapi uvicorn httpx websockets python-multipart sqlalchemy psycopg2-binary kubernetes requests "celery[redis]" kafka-python-ng argon2-cffi cryptography

COPY backend/app/ ./app/
COPY frontend/public/logos/ ./public/logos/
COPY backend/migrations/ ./migrations/
COPY backend/celery_app.py ./celery_app.py
COPY backend/tasks/ ./tasks/
COPY backend/scripts/ ./scripts/
COPY deploy/ /opt/deploy/
COPY demos/deploy/ /opt/demos-deploy/
COPY config/ /opt/config/

# Catalog items (YAML-driven demo definitions)
COPY catalog/ /opt/catalog/

# Quickstarts are optional — cloned upstream repos, not always in git.
RUN mkdir -p /opt/quickstarts
RUN if [ -d /opt/quickstarts/rag ]; then \
      helm repo add ai-quickstart https://rh-ai-quickstart.github.io/ai-architecture-charts 2>/dev/null || true \
      && helm repo update 2>/dev/null || true \
      && cd /opt/quickstarts/rag/deploy/helm/rag && helm dependency build . 2>&1 || true \
      && cd /opt/quickstarts/llm-cpu-serving/helm && helm dependency build . 2>&1 || true; \
    else echo "Quickstarts not present — skipping Helm dependency build"; fi

USER 1001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
