# skopeo v1.24.1 built from the immutable upstream source tag with a pinned
# Go toolchain. skopeo publishes no release binaries, and the vendor container
# image is built against an incompatible glibc, so the checksum-pinned source
# tarball is the immutable artifact. CGO_ENABLED=0 matches the static upstream
# build shape.
FROM golang:1.27.2@sha256:820153096fda4de6ac1b7194d12e416b7dd8f4e9a33d17e0345b111b945162d8 AS skopeo-build
ADD --checksum=sha256:6a3f342a327ec7684198eb0e15114940b6101506db48d9a96590f5942cb3b335 \
  https://github.com/containers/skopeo/archive/refs/tags/v1.24.1.tar.gz /tmp/skopeo-v1.24.1.tar.gz
RUN tar -xzf /tmp/skopeo-v1.24.1.tar.gz -C /tmp \
  && cd /tmp/skopeo-1.24.1 \
  && go mod edit \
    -replace=golang.org/x/net=golang.org/x/net@v0.60.0 \
    -replace=golang.org/x/text=golang.org/x/text@v0.41.0 \
    -replace=golang.org/x/crypto=golang.org/x/crypto@v0.57.0 \
    -replace=google.golang.org/grpc=google.golang.org/grpc@v1.83.2 \
  && CGO_ENABLED=0 go test -mod=mod -count=1 \
    -tags "containers_image_openpgp exclude_graphdriver_btrfs" ./cmd/skopeo \
  && CGO_ENABLED=0 go build -mod=mod -trimpath \
    -tags "containers_image_openpgp exclude_graphdriver_btrfs" \
    -o /out/skopeo ./cmd/skopeo \
  && go version -m /out/skopeo > /out/skopeo-build-info.txt \
  && grep -F "golang.org/x/net" /out/skopeo-build-info.txt | grep -F "v0.60.0" \
  && grep -F "golang.org/x/text" /out/skopeo-build-info.txt | grep -F "v0.41.0" \
  && grep -F "golang.org/x/crypto" /out/skopeo-build-info.txt | grep -F "v0.57.0" \
  && grep -F "google.golang.org/grpc" /out/skopeo-build-info.txt | grep -F "v1.83.2"

FROM quay.io/rhpds/openshift-showroom-terminal-ocp@sha256:606317dc396db33b879c1d3807844990cd37bb0c787b0b525edbeb70283b5350

USER 0
# Refresh supported OS packages without removing the existing learner toolchain.
# Embedded standalone CLIs remain subject to the complete image security scan.
# The el10 upgrade consolidates /etc/passwd and drops the base image's
# hand-added runtime user, so restore the exact inherited entry afterwards;
# learner CLIs that perform user lookups (odo) fail without it.
RUN dnf -y --refresh upgrade \
    && dnf clean all \
    && { grep -q '^1001:' /etc/passwd \
      || echo '1001:*:1001:0:container user:/home/lab-user:/bin/sh' >> /etc/passwd; }

COPY --from=skopeo-build /out/skopeo /usr/bin/skopeo
COPY --from=skopeo-build /out/skopeo-build-info.txt /opt/launchpad-client-proof/skopeo-build-info.txt
RUN chmod 0755 /usr/bin/skopeo

# Refresh the remaining embedded learner CLIs from checksum-pinned vendor
# artifacts; see cli-refresh.sh for the pins and the odo sourcing note.
COPY cli-refresh.sh /tmp/cli-refresh.sh
RUN bash /tmp/cli-refresh.sh && rm -f /tmp/cli-refresh.sh

COPY launchpad-runttyd /usr/local/bin/launchpad-runttyd
RUN chmod 0755 /usr/local/bin/launchpad-runttyd
USER 1001

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/launchpad-runttyd"]
