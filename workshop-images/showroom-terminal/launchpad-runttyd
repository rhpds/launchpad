#!/usr/bin/env bash
set -euo pipefail

: "${NAMESPACE:?The Showroom terminal requires its seat namespace}"

export USER=lab-user
export HOME=/home/lab-user
export KUBECONFIG="${HOME}/.kube/config"

mkdir -p "${HOME}/.kube"
umask 077
cat >"${KUBECONFIG}" <<EOF
apiVersion: v1
kind: Config
clusters:
- name: in-cluster
  cluster:
    server: https://kubernetes.default.svc
    certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
users:
- name: showroom
  user:
    tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
contexts:
- name: seat
  context:
    cluster: in-cluster
    user: showroom
    namespace: ${NAMESPACE}
current-context: seat
EOF

RUNTIME_SECRET=launchpad-participant-runtime

read_runtime_value() {
  oc get secret "${RUNTIME_SECRET}" -n "${NAMESPACE}" \
    -o "jsonpath={.data.$1}" 2>/dev/null | base64 --decode 2>/dev/null || true
}

# The Showroom RoleBinding and pod can become ready in either order. Wait
# briefly for the service account to receive namespace access, then expose the
# seat-scoped model contract to terminal shells without placing it in Argo CD.
for _attempt in $(seq 1 30); do
  if oc get secret "${RUNTIME_SECRET}" -n "${NAMESPACE}" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
export MAAS_API_KEY="$(read_runtime_value MAAS_API_KEY)"
export MAAS_ENDPOINT="$(read_runtime_value MAAS_ENDPOINT)"
export MAAS_API_URL="$(read_runtime_value MAAS_API_URL)"
export MAAS_MODEL="$(read_runtime_value MAAS_MODEL)"

cleanup_home_for_reclaim() {
  # nfs-subdir-external-provisioner is root-squashed. It needs write access to
  # participant-created subdirectories in order to honor reclaimPolicy=Delete.
  chmod -R a+rwX "${HOME}" 2>/dev/null || true
}

trap cleanup_home_for_reclaim EXIT
/usr/bin/runttyd &
runttyd_pid=$!
trap 'kill -TERM "${runttyd_pid}" 2>/dev/null || true' TERM INT HUP
wait "${runttyd_pid}"
