{
  "realm": "launchpad-public",
  "flowAlias": "Launchpad public passwordless browser",
  "providerId": "launchpad-order-code",
  "executions": [
    {"providerId": "auth-cookie", "requirement": "ALTERNATIVE"},
    {"providerId": "launchpad-order-code", "requirement": "ALTERNATIVE"}
  ],
  "clients": [
    {
      "clientId": "openshift-launchpad-public",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": ["https://oauth-openshift.apps.oberon.fm2aihpcsed.com/oauth2callback/launchpad-public"]
    },
    {
      "clientId": "launchpad-public-gateway",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": ["https://*.labs.example.invalid/oauth2/callback"]
    }
  ],
  "notes": "Create client secrets at deployment time; they are intentionally absent from Git. The cookie execution must precede the order-code execution so an existing participant session silently completes the OpenShift Console OIDC flow. A new browser without that session falls through to the email and instructor-code claim form."
}
