FROM registry.access.redhat.com/ubi9/openjdk-17:latest AS build
USER 0
RUN microdnf install -y maven && microdnf clean all
WORKDIR /src
COPY pom.xml .
COPY src src
RUN mvn -B -DskipTests package

FROM quay.io/keycloak/keycloak:26.8.1@sha256:ed1cab21814c7d18ce8f0e11d5a1fa1c6923de12dd4c7625a18c5d34452a57a4
COPY --from=build /src/target/launchpad-code-authenticator-1.0.0.jar /opt/keycloak/providers/
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build
